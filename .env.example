# SPIRIT 3.0 – Buildathon Submission Portal Configuration
# Set mode to 'demo' for local testing with simulated latency and deterministic IDs.
# Set mode to 'production' to submit real multipart/form-data payloads to the backend API.
VITE_APP_MODE=demo

# Backend API Base URL (Do not include trailing slash)
# In production, this points to your DSMNRU Next.js/Express/FastAPI backend endpoint.
VITE_API_BASE_URL=https://api.spirit-dsmnru.vercel.app

# Official submission deadline in ISO 8601 string format with timezone offset
# Default: 24 October 2026, 23:59:59 IST (+05:30)
VITE_SUBMISSION_DEADLINE=2026-10-24T23:59:59+05:30

# Existing main event URL for the "Back to Event" breadcrumb and return links
VITE_EVENT_URL=https://spirit-dsmnru.vercel.app/events/spirit-3-0-buildathon
